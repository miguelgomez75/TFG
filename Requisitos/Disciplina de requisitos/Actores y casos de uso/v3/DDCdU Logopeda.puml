@startuml

left to right direction

actor Logopeda

rectangle Sistema_CAA {

  ' ── AUTENTICACIÓN ───────────────────────────────────────
  package "Autenticación" {
    Logopeda -- (Logout)
  }

  ' ── GESTIÓN DE PACIENTES ──────────────────────────────────
  package "Gestión de pacientes" {
    Logopeda -- (Crear paciente)
    Logopeda -- (Editar paciente)
    Logopeda -- (Consultar paciente)
    Logopeda -- (Ver progreso paciente)
  }

  ' ── GESTIÓN DE ACTIVIDADES ────────────────────────────────
  package "Gestión de actividades" {
    Logopeda -- (Crear actividad)
    Logopeda -- (Editar actividad)
    Logopeda -- (Ver actividad)
    Logopeda -- (Publicar actividad)
    Logopeda -- (Archivar actividad)
    Logopeda -- (Asignar actividad)
    Logopeda -- (Recomendar actividad)
  }

  ' ── SEGUIMIENTO TERAPÉUTICO ───────────────────────────────
  package "Seguimiento terapéutico" {
    Logopeda -- (Registrar sesión)
    Logopeda -- (Consultar sesiones)
  }

  ' ── REGISTROS CLÍNICOS ────────────────────────────────────
  package "Registros clínicos" {
    Logopeda -- (Crear registro)
    Logopeda -- (Editar registro)
    Logopeda -- (Eliminar registro)
  }

}

@enduml
